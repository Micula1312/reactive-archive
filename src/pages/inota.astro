---
const title = "Reactive Archive — INOTA";
---

<html lang="it" data-performance="inota">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.ico`} />
    <title>{title}</title>
  </head>

  <body data-performance="inota">
    <main id="app">
      <canvas id="visual-canvas"></canvas>

      <aside id="debug-panel" hidden>
        <p>AUDIO <span id="audio-value">0.000</span></p>
        <p>BASS <span id="bass-value">0.000</span></p>
        <p>MID <span id="mid-value">0.000</span></p>
        <p>HIGH <span id="high-value">0.000</span></p>
        <p class="debug-help">H pannello · A reactive · B blackout · frecce scene</p>
      </aside>

      <section id="start-screen">
        <div class="start-panel">
          <p class="eyebrow">INOTA · 3600 × 2400 · 08:00</p>
          <h1>Reactive Archive</h1>
          <p id="status">Inserisci master.wav in public/inota/audio/ e premi AVVIA.</p>
          <button id="start-button" type="button">AVVIA</button>
        </div>
      </section>

      <video id="source-video" muted loop playsinline preload="auto"></video>
    </main>

    <script>
      import "../scripts/main.js";
    </script>
  </body>
</html>

<style is:global>
  * { box-sizing: border-box; }
  html, body { width: 100%; height: 100%; margin: 0; overflow: hidden; background: #000; color: #fff; font-family: Arial, Helvetica, sans-serif; }
  #app { position: fixed; inset: 0; display: grid; place-items: center; background: #000; }
  #visual-canvas { display: block; background: #000; transition: opacity 120ms linear; }
  #visual-canvas.blackout { opacity: 0; }
  #source-video { display: none; }
  #start-screen { position: fixed; inset: 0; z-index: 100; display: grid; place-items: center; padding: 24px; background: #000; }
  #start-screen[hidden] { display: none; }
  .start-panel { width: min(620px, 100%); }
  .eyebrow { margin: 0 0 18px; font-size: 12px; letter-spacing: 0.16em; }
  h1 { margin: 0 0 20px; font-size: clamp(42px, 8vw, 88px); font-weight: 500; line-height: 0.9; }
  #status { margin: 0 0 28px; font-size: 15px; line-height: 1.45; }
  #start-button { border: 1px solid #fff; border-radius: 0; padding: 16px 22px; background: #fff; color: #000; font: inherit; font-weight: 700; cursor: pointer; }
  #start-button:disabled { opacity: 0.5; cursor: wait; }
  #debug-panel { position: fixed; top: 16px; right: 16px; z-index: 90; width: 240px; padding: 14px; border: 1px solid rgb(255 255 255 / 35%); background: rgb(0 0 0 / 78%); color: #fff; font-family: monospace; font-size: 12px; pointer-events: none; }
  #debug-panel p { display: flex; justify-content: space-between; gap: 20px; margin: 0 0 8px; }
  #debug-panel .debug-help { display: block; margin-top: 14px; margin-bottom: 0; color: rgb(255 255 255 / 55%); line-height: 1.5; }
</style>
