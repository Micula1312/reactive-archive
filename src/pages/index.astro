<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <title>Reactive Archive — FMCP</title>
  </head>

  <body>
    <main id="app">
      <video
        id="source-video"
        playsinline
        muted
        crossorigin="anonymous"
      ></video>

      <canvas id="visual-canvas"></canvas>

      <section id="start-screen">
        <div class="start-panel">
          <h1>FMCP</h1>

          <button id="start-button" type="button">
            START PERFORMANCE
          </button>

          <p id="status">Pronta</p>
        </div>
      </section>

      <aside id="debug-panel" hidden>
        <div>AUDIO <span id="audio-value">0.000</span></div>
        <div>BASS <span id="bass-value">0.000</span></div>
        <div>MID <span id="mid-value">0.000</span></div>
        <div>HIGH <span id="high-value">0.000</span></div>
      </aside>
    </main>

    <script src="../scripts/main.js"></script>
  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
  }

  html,
  body {
    width: 100%;
    height: 100%;
    margin: 0;
    overflow: hidden;
    background: #000;
    color: #fff;
    font-family: Arial, Helvetica, sans-serif;
  }

  #app {
    position: fixed;
    inset: 0;
    background: #000;
  }

  #source-video {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    visibility: hidden;
  }

  #visual-canvas {
    position: fixed;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    background: #000;
  }

  #visual-canvas.blackout {
    opacity: 0;
  }

  #start-screen {
    position: fixed;
    inset: 0;
    z-index: 20;
    display: grid;
    place-items: center;
    background: #000;
  }

  #start-screen[hidden] {
    display: none;
  }

  .start-panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
  }

  .start-panel h1 {
    margin: 0;
    font-size: clamp(42px, 10vw, 140px);
    font-weight: 400;
    letter-spacing: -0.06em;
  }

  #start-button {
    padding: 15px 24px;
    border: 1px solid #fff;
    background: transparent;
    color: #fff;
    font: inherit;
    cursor: pointer;
  }

  #start-button:hover {
    color: #000;
    background: #fff;
  }

  #status {
    margin: 0;
    font-size: 12px;
    opacity: 0.65;
  }

  #debug-panel {
    position: fixed;
    top: 16px;
    left: 16px;
    z-index: 30;
    padding: 14px;
    background: rgba(0, 0, 0, 0.75);
    font-family: monospace;
    font-size: 12px;
    line-height: 1.7;
    pointer-events: none;
  }
</style>
