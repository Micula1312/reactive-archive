---
const title = "Reactive Archive — Elisa";

const basePath = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const fallbackVideo = `${basePath}elisa/videos/video-01.mp4`;
---

<html lang="it" data-performance="elisa">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.ico`} />
    <title>{title}</title>
  </head>

  <body data-performance="elisa">
    <main id="app">
      <canvas id="visual-canvas"></canvas>

      <aside id="debug-panel" hidden>
        <p>AUDIO <span id="audio-value">0.000</span></p>
        <p>BASS <span id="bass-value">0.000</span></p>
        <p>MID <span id="mid-value">0.000</span></p>
        <p>HIGH <span id="high-value">0.000</span></p>
        <p class="debug-help">H pannello · A reactive · M mic/fake · B blackout · S sottotitoli</p>
      </aside>

      <nav
        id="mobile-scene-controls"
        aria-label="Controlli scene"
        aria-hidden="true"
      >
        <button id="mobile-scene-previous" type="button" aria-label="Scena precedente">←</button>
        <button id="mobile-scene-next" type="button" aria-label="Scena successiva">→</button>
      </nav>

      <section id="start-screen">
        <div class="start-panel">
          <p class="eyebrow">ELISA — AICHA KANDISHA</p>
          <h1>Reactive Archive</h1>
          <p id="status">Premi AVVIA. Il microfono verrà richiesto senza bloccare la performance.</p>
          <button id="start-button" type="button">AVVIA</button>
        </div>
      </section>

      <video id="source-video" src={fallbackVideo} muted loop playsinline preload="auto"></video>
    </main>

    <script>
      import "../scripts/main.js";
      import SubtitleManager from "../scripts/SubtitleManager.js";

      const subtitles = new SubtitleManager();
      const controls = document.querySelector("#mobile-scene-controls");
      const previousButton = document.querySelector("#mobile-scene-previous");
      const nextButton = document.querySelector("#mobile-scene-next");
      const app = document.querySelector("#app");
      const startScreen = document.querySelector("#start-screen");
      const startButton = document.querySelector("#start-button");

      let controlsTimer = 0;
      let lastRevealTime = 0;

      function triggerSceneKey(key) {
        window.dispatchEvent(
          new KeyboardEvent("keydown", {
            key,
            code: key,
            bubbles: true,
            cancelable: true
          })
        );
      }

      function hideMobileControls() {
        if (!(controls instanceof HTMLElement)) return;
        controls.classList.remove("is-visible");
        controls.setAttribute("aria-hidden", "true");
      }

      function showMobileControls() {
        if (!(controls instanceof HTMLElement)) return;
        if (startScreen instanceof HTMLElement && !startScreen.hidden) return;

        controls.classList.add("is-visible");
        controls.setAttribute("aria-hidden", "false");
        window.clearTimeout(controlsTimer);
        controlsTimer = window.setTimeout(hideMobileControls, 3000);
      }

      function revealControls(event) {
        const target = event.target;
        if (target instanceof Element && target.closest("#mobile-scene-controls")) return;

        const now = Date.now();
        if (now - lastRevealTime < 120) return;
        lastRevealTime = now;
        showMobileControls();
      }

      previousButton?.addEventListener("click", (event) => {
        event.preventDefault();
        event.stopPropagation();
        triggerSceneKey("ArrowLeft");
        showMobileControls();
      });

      nextButton?.addEventListener("click", (event) => {
        event.preventDefault();
        event.stopPropagation();
        triggerSceneKey("ArrowRight");
        showMobileControls();
      });

      if (app) {
        if ("PointerEvent" in window) {
          app.addEventListener("pointerdown", revealControls, { passive: true });
        } else {
          app.addEventListener("touchstart", revealControls, { passive: true });
          app.addEventListener("mousedown", revealControls);
        }

        app.addEventListener("click", revealControls);
      }

      startButton?.addEventListener("click", () => {
        window.setTimeout(showMobileControls, 350);
      });

      window.addEventListener("reactive-archive:scene-change", (event) => {
        subtitles.setScene(event.detail?.scene ?? null);
      });

      window.addEventListener("keydown", (event) => {
        if (event.key.toLowerCase() !== "s") return;
        const enabled = subtitles.toggle();
        console.info(`Sottotitoli ${enabled ? "attivi" : "disattivati"}`);
      });

      function updateSubtitles() {
        requestAnimationFrame(updateSubtitles);
        subtitles.update();
      }

      updateSubtitles();
    </script>
  </body>
</html>

<style is:global>
  * { box-sizing: border-box; }
  html, body { width: 100%; height: 100%; margin: 0; overflow: hidden; background: #000; color: #fff; font-family: Arial, Helvetica, sans-serif; }
  body { min-height: 100vh; min-height: 100dvh; }
  button { -webkit-tap-highlight-color: transparent; }
  #app { position: fixed; inset: 0; background: #000; touch-action: manipulation; overscroll-behavior: none; }
  #visual-canvas { display: block; width: 100%; height: 100%; background: #000; transition: opacity 120ms linear; }
  #visual-canvas.blackout { opacity: 0; }
  #source-video { display: none; }
  #start-screen { position: absolute; inset: 0; z-index: 10; display: grid; place-items: center; padding: 24px; background: #000; }
  #start-screen[hidden] { display: none; }
  .start-panel { width: min(520px, 100%); }
  .eyebrow { margin: 0 0 18px; font-size: 12px; letter-spacing: 0.16em; }
  h1 { margin: 0 0 20px; font-size: clamp(42px, 8vw, 88px); font-weight: 500; line-height: 0.9; }
  #status { margin: 0 0 28px; font-size: 15px; }
  #start-button { border: 1px solid #fff; border-radius: 0; padding: 16px 22px; background: #fff; color: #000; font: inherit; font-weight: 700; cursor: pointer; }
  #start-button:disabled { opacity: 0.5; cursor: wait; }
  #debug-panel { position: absolute; top: 16px; right: 16px; z-index: 5; width: 220px; padding: 14px; border: 1px solid rgb(255 255 255 / 35%); background: rgb(0 0 0 / 78%); color: #fff; font-family: monospace; font-size: 12px; pointer-events: none; }
  #debug-panel p { display: flex; justify-content: space-between; gap: 20px; margin: 0 0 8px; }
  #debug-panel .debug-help { display: block; margin-top: 14px; margin-bottom: 0; color: rgb(255 255 255 / 55%); line-height: 1.5; }

  #mobile-scene-controls {
    position: fixed;
    inset: 0;
    z-index: 9;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 18px;
    padding-top: max(20px, env(safe-area-inset-top));
    padding-right: max(18px, env(safe-area-inset-right));
    padding-bottom: max(20px, env(safe-area-inset-bottom));
    padding-left: max(18px, env(safe-area-inset-left));
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 220ms ease, visibility 0s linear 220ms;
  }

  #mobile-scene-controls.is-visible {
    opacity: 1;
    visibility: visible;
    transition-delay: 0s;
  }

  #mobile-scene-controls button {
    width: 64px;
    height: 64px;
    min-width: 48px;
    min-height: 48px;
    display: grid;
    place-items: center;
    padding: 0;
    border: 1px solid rgb(255 255 255 / 70%);
    border-radius: 50%;
    background: rgb(0 0 0 / 62%);
    color: #fff;
    font: 400 34px/1 Arial, Helvetica, sans-serif;
    -webkit-appearance: none;
    appearance: none;
    pointer-events: auto;
    touch-action: manipulation;
    user-select: none;
    -webkit-user-select: none;
    cursor: pointer;
  }

  @supports ((-webkit-backdrop-filter: blur(8px)) or (backdrop-filter: blur(8px))) {
    #mobile-scene-controls button {
      background: rgb(0 0 0 / 42%);
      -webkit-backdrop-filter: blur(8px);
      backdrop-filter: blur(8px);
    }
  }

  #mobile-scene-controls button:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
  }

  #mobile-scene-controls button:active {
    background: #fff;
    color: #000;
    transform: scale(0.94);
  }

  @media (prefers-reduced-motion: reduce) {
    #visual-canvas,
    #mobile-scene-controls {
      transition: none;
    }
  }

  @media (min-width: 901px) and (hover: hover) and (pointer: fine) {
    #mobile-scene-controls { display: none !important; }
  }
</style>
